# Environment: development, test, or production
NODE_ENV=development

# Server Configuration
PORT=3000
# Behind a reverse proxy/load balancer set the number of proxy hops (e.g. 1), otherwise leave empty.
# Wrong values let clients spoof their IP and bypass rate limits.
TRUST_PROXY=
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Secrets. In production the server refuses to start if these are missing, default, or weak:
#   AUTH_SESSION_SECRET >= 32 random chars (e.g. `openssl rand -hex 32`)
#   PLATFORM_ADMIN_EMAIL must not be admin@loyalpass.local
#   PLATFORM_ADMIN_PASSWORD >= 12 chars and not a known default
AUTH_SESSION_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Database Configuration
DB_DIALECT=sqlite                # sqlite or postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=loyalpass

# SQLite Configuration (used when DB_DIALECT=sqlite)
DB_STORAGE=./dev.sqlite3

# Logging
LOG_LEVEL=debug                  # trace, debug, info, warn, error, fatal, silent
# Optional error reporting (requires `npm i @sentry/node`)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_VERSION=                     # reported as `release` on logs and Sentry events

# Apple Wallet Configuration
# Get from https://developer.apple.com
APPLE_TEAM_ID=your_team_id
APPLE_KEY_ID=your_key_id
APPLE_CERTIFICATE_PATH=./certs/apple_certificate.p8

# Google Wallet Configuration
# Get from https://developers.google.com/pay/passes
GOOGLE_CLIENT_EMAIL=your_service_account@appspot.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# API Configuration
API_KEY_LENGTH=64
API_KEY_ALGORITHM=sha256

# CORS Configuration
CORS_ORIGINS=http://localhost:3001   # comma-separated; enforced in production, "*" is rejected

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=LoyalPass <no-reply@example.com>

# BAC Credomatic adapter (confirm paths/auth with your regional BAC account)
BAC_API_BASE_URL=https://api.example.com
BAC_API_KEY=your_bac_api_key
BAC_CREATE_PAYMENT_PATH=/payments
