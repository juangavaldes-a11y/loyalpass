{
  "name": "loyalpass-backend",
  "version": "1.0.0",
  "description": "Multi-business loyalty platform with Apple Wallet and Google Wallet integration",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "docker:build": "docker build -t loyalpass:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env loyalpass:latest",
    "docker:compose": "docker-compose up",
    "docker:compose:build": "docker-compose up --build",
    "test": "jest"
  },
  "keywords": [
    "loyalty",
    "wallet",
    "apple-wallet",
    "google-wallet",
    "points"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.2",
    "pg": "^8.8.0",
    "pg-hstore": "^2.3.4",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0",
    "qrcode": "^1.5.3",
    "pkpass": "^1.4.0",
    "google-auth-library": "^8.8.0",
    "node-fetch": "^2.6.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "config": "^3.3.11"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "sequelize-cli": "^6.6.1"
  }
}
