              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/passes/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "passes", "create"]
            }
          }
        },
        {
          "name": "Get Pass",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/passes/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "passes", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Update Pass",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
