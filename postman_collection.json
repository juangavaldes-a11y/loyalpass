              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pass_id\": \"{{passId}}\",\n  \"customer_id\": \"{{customerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/passes/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "passes", "update"]
            }
          }
        }
      ]
    },
    {
      "name": "Points System",
      "item": [
        {
          "name": "Get Points Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/points/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "points", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Add Points",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"amount\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add",
              "host": ["{{baseUrl}}"],
              "path": ["api", "points", "add"]
            }
          }
        },
        {
          "name": "Redeem Points",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"amount\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/redeem",
              "host": ["{{baseUrl}}"],
              "path": ["api", "points", "redeem"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "businessId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "passId",
      "value": "",
      "type": "string"
    }
  ]
}
