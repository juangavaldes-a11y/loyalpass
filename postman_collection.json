{
  "info": {
    "name": "LoyalPass API",
    "description": "Multi-business loyalty platform with wallet integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Business Management",
      "item": [
        {
          "name": "Create Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee Corner\",\n  \"logo_url\": \"https://example.com/logo.png\",\n  \"brand_color\": \"#8B4513\",\n  \"text_color\": \"#FFFFFF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/businesses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses"]
            }
          }
        },
        {
          "name": "Get Business",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}"]
            }
          }
        },
        {
          "name": "Update Business",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Business Name\",\n  \"brand_color\": \"#FF9900\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}"]
            }
          }
        },
        {
          "name": "Get API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "api-keys"]
            }
          }
        },
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "api-keys"]
            }
          }
        },
        {
          "name": "Rotate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/businesses/{{businessId}}/api-keys/rotate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "businesses", "{{businessId}}", "api-keys", "rotate"]
            }
          }
        }
      ]
    },
    {
